# Salin ke .env lalu isi nilainya. Berkas .env tidak masuk repo.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hanya untuk server. Jangan diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# AI (Google AI Studio)
GEMINI_API_KEY=
# Opsional, cadangan bila Gemini tidak tersedia
OPENAI_API_KEY=
# gemini | openai
AI_PROVIDER=gemini
# Opsional
GEMINI_MODEL=
AI_MODEL_TIMEOUT_MS=
AI_LESSON_BUDGET_MS=
AI_CHAIN_BUDGET_MS=

# true = pakai materi cadangan tanpa memanggil AI (demo atau saat kuota habis)
NEXT_PUBLIC_DEMO_MODE=false
